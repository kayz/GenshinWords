{
  "name": "genshin-words",
  "version": "1.2.1",
  "description": "Local Genshin Impact dialogue vocabulary trainer (non-commercial)",
  "main": "./out/main/index.js",
  "author": "GenshinWords",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-electron.mjs dev",
    "start": "node scripts/run-electron.mjs preview",
    "build": "electron-vite build",
    "typecheck": "node scripts/typecheck.cjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build:installer",
    "build:installer": "npm run typecheck && npm run build && electron-builder --config electron-builder.install.yml --win nsis --x64 --publish never",
    "build:portable": "npm run reading:build-base && npm run check:content && npm run typecheck && npm run build && electron-builder --win portable --x64 --publish never",
    "pack:assets": "node scripts/pack-assets.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:blockers": "node --test tests/blockers.test.cjs",
    "test:practice": "node --test tests/practice.test.cjs",
    "check:practice": "node scripts/check-practice.cjs",
    "test:collection-ui": "node --test tests/collection-ui.test.cjs",
    "test:ipc": "node --test tests/ipc.test.cjs",
    "check:interface": "node scripts/check-interface.cjs",
    "test:portraits": "node --test tests/portraits.test.cjs",
    "content:update": "pwsh -NoProfile -File scripts/update-materials.ps1",
    "content:match": "node scripts/match-materials.mjs",
    "check:materials": "node scripts/check-materials.mjs",
    "test:reading": "node --test tests/reading.test.cjs tests/reading-package-migration.test.cjs tests/reading-packages.test.cjs tests/reading-package-format.test.cjs tests/reading-source-version.test.cjs",
    "check:reading-interface": "node scripts/check-reading-interface.cjs",
    "test:traveler-ui": "node --test tests/traveler-ui.test.cjs",
    "icons:build": "node scripts/build-icons.mjs",
    "test:study-options": "node --test tests/study-options.test.cjs",
    "check:chapters": "node scripts/audit-chapters.cjs",
    "check:reading-capacity": "node scripts/audit-reading-capacity.cjs",
    "reading:validate": "node scripts/reading-package.cjs validate",
    "reading:pack": "node scripts/reading-package.cjs pack",
    "reading:build-base": "node scripts/reading-package.cjs pack reading-library/base --out content/reading/base.gwreading",
    "prebuild": "npm run reading:build-base && npm run words:build-base",
    "predev": "npm run reading:build-base && npm run words:build-base",
    "prestart": "npm run reading:build-base && npm run words:build-base",
    "test:reading-packages": "node --test tests/reading-package-migration.test.cjs tests/reading-packages.test.cjs tests/reading-package-format.test.cjs tests/reading-source-version.test.cjs",
    "check:reading-packages-interface": "node scripts/check-reading-packages-interface.cjs",
    "content:validate": "node scripts/content-package.cjs validate",
    "content:pack": "node scripts/content-package.cjs pack",
    "words:build-base": "node scripts/build-word-packages.cjs",
    "test:content-packages": "node --test tests/content-package-format.test.cjs tests/content-packages.test.cjs",
    "check:content-packages-interface": "node scripts/check-content-packages-interface.cjs",
    "test:resource-directories": "node --test tests/resource-directory-raw.test.cjs tests/resource-directories.test.cjs",
    "test:installer-base": "node --test tests/installer-base.test.cjs",
    "check:resource-directories-interface": "node scripts/check-resource-directories-interface.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "pdfkit": "^0.20.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.13.1",
    "sharp": "^0.35.5",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
